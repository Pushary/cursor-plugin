{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node ./scripts/pushary-gate.mjs",
        "timeout": 60,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node ./scripts/pushary-gate.mjs",
        "timeout": 60,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "node ./scripts/pushary-gate.mjs",
        "matcher": "Write|Delete|Edit",
        "timeout": 60,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "node ./scripts/pushary-gate.mjs",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node ./scripts/pushary-gate.mjs",
        "timeout": 10
      }
    ],
    "sessionStart": [
      {
        "command": "node ./scripts/pushary-gate.mjs",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "node ./scripts/pushary-gate.mjs",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node ./scripts/pushary-gate.mjs",
        "timeout": 10
      }
    ],
    "preCompact": [
      {
        "command": "node ./scripts/pushary-gate.mjs",
        "timeout": 10
      }
    ],
    "subagentStart": [
      {
        "command": "node ./scripts/pushary-gate.mjs",
        "timeout": 10
      }
    ],
    "subagentStop": [
      {
        "command": "node ./scripts/pushary-gate.mjs",
        "timeout": 10
      }
    ]
  }
}
